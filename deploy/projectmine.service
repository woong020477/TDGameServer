[Unit]
Description=ProjectMine TCP and UDP game server
After=network.target mysql.service
Requires=mysql.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=projectmine
Group=projectmine
WorkingDirectory=/opt/projectmine/releases/20260907-01
ExecStart=/opt/projectmine/releases/20260907-01/TDGameServer
EnvironmentFile=/etc/projectmine/server.env

# The current application handles Ctrl+C through Console.CancelKeyPress.
KillSignal=SIGINT
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

# Keep the executable read-only and limit access to the host filesystem.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=projectmine

[Install]
WantedBy=multi-user.target
